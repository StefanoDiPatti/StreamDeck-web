// Applicazioni avviabili dai pulsanti { "type": "launch", "app": "<id>" }.
// Ogni app può avere una variante "windows" e/o "linux".
//  path : eseguibile, collegamento .lnk, percorso assoluto o comando nel PATH.
//         Ammessi %VAR% (Windows), $VAR e ~ (Linux) e * per le versioni.
//         Windows: "shell:AppsFolder\<AppID>" avvia le app dello Store
//         (trovi l'AppID con PowerShell: Get-StartApps).
//  args : lista di argomenti (opzionale)   cwd : cartella di lavoro (opzionale)
//  toggle : true = il pulsante mostra se l'app è aperta e, se lo è, la chiude
//           (come la X della finestra: l'app può chiedere di salvare)
//  path : può essere anche una lista di percorsi possibili: vale il primo che esiste
//  process: nome del processo, se diverso dal file (es. "discord"); anche una lista
//  whenRunning: "focus" = se è già aperta il pulsante la porta in primo piano (giochi)
//  game : true = è un gioco: il Go Live di Discord trasmette questo, se è aperto
//  title  : regex sul titolo della finestra, per distinguere app con lo stesso processo
//  bridge : "apple" | "youtube" | "ytmusic" = web app riconosciuta dall'estensione del browser
//  "linux" (o "windows") può essere anche una LISTA di alternative: vale la prima
//         installata (es. Konsole, poi GNOME Terminal...). I file .desktop
//         (web app di Brave/Chrome, app scaricate) si avviano con gtk-launch.
{
  "apps": {
    "blender": {
      "label": "Blender",
      "toggle": true,
      "windows": { "path": "C:\\Program Files\\Blender Foundation\\Blender *\\blender.exe" },
      "linux": { "path": "blender" }
    },
    "davinci": {
      "label": "DaVinci Resolve",
      "toggle": true,
      "windows": { "path": "C:\\Program Files\\Blackmagic Design\\DaVinci Resolve\\Resolve.exe" },
      "linux": { "path": "/opt/resolve/bin/resolve" }
    },
    "vscode": {
      "label": "VS Code",
      "toggle": true,
      "windows": { "path": "%LOCALAPPDATA%\\Programs\\Microsoft VS Code\\Code.exe" },
      "linux": { "path": "code" }
    },
    "unreal": {
      "label": "Unreal Editor",
      "toggle": true,
      "windows": { "path": "C:\\Program Files\\Epic Games\\UE_*\\Engine\\Binaries\\Win64\\UnrealEditor.exe" },
      "linux": { "path": "~/UnrealEngine/Engine/Binaries/Linux/UnrealEditor" }
    },
    // Radio Monte Carlo: lo stream ufficiale (server Mediaset di Segrate) in una finestra di Brave
    // a parte (--app), così il pulsante la spegne chiudendo solo quella finestra.
    "radio_montecarlo": {
      "label": "Radio Monte Carlo",
      "toggle": true,
      "process": "brave",
      "title": "unitedradio\\.it/RMC",
      "windows": {
        "path": "C:\\Program Files\\BraveSoftware\\Brave-Browser\\Application\\brave.exe",
        "args": ["--profile-directory=Default", "--app=https://icy.unitedradio.it/RMC.mp3"]
      },
      "linux": [
        { "path": "brave-browser", "args": ["--app=https://icy.unitedradio.it/RMC.mp3"] },
        { "path": "xdg-open", "args": ["https://icy.unitedradio.it/RMC.mp3"] }
      ]
    },
    "apple_music": {
      "label": "Apple Music",
      "toggle": true,
      "bridge": "apple",
      // Web app in Brave: stessi parametri del collegamento sul desktop
      "windows": {
        "path": "C:\\Program Files\\BraveSoftware\\Brave-Browser\\Application\\brave.exe",
        "args": ["--profile-directory=Default", "https://music.apple.com/us/new"]
      },
      // Linux: la web app installata da Brave (collegamento sul desktop), altrimenti il sito
      "linux": [
        { "path": "~/.local/share/applications/brave-blgdilankhbcpipclgpdndahbehalgkh-Default.desktop" },
        { "path": "xdg-open", "args": ["https://music.apple.com"] }
      ]
    },
    "spotify": {
      "label": "Spotify",
      "toggle": true,
      "windows": { "path": "%APPDATA%\\Spotify\\Spotify.exe" },
      "linux": { "path": "spotify" }
    },
    "claude_desktop": {
      "label": "Claude",
      "toggle": true,
      "process": "claude",
      "windows": { "path": "shell:AppsFolder\\Claude_pzs8sxrjxfjjc!Claude" },
      // Linux: la web app di Claude installata da Brave (collegamento sul desktop), altrimenti il sito
      "linux": [
        { "path": "~/.local/share/applications/brave-fmpnliohjhemenmnlpbfagaolkdacoja-Default.desktop", "toggle": false },
        { "path": "xdg-open", "args": ["https://claude.ai"], "toggle": false }
      ]
    },
    "viber": {
      "label": "Viber",
      "linux": [
        { "path": "~/.local/share/applications/viber.desktop" },
        { "path": "~/.local/opt/Viber/@viberdesktop" },
        { "path": "viber" }
      ]
    },
    "claude_code": {
      "label": "Claude Code",
      "windows": { "path": "powershell.exe", "args": ["-NoExit", "-Command", "claude"], "cwd": "%USERPROFILE%\\Documents\\AI Projects" },
      "linux": [
        { "path": "konsole", "args": ["-e", "claude"], "cwd": "~" },
        { "path": "gnome-terminal", "args": ["--", "claude"], "cwd": "~" },
        { "path": "alacritty", "args": ["-e", "claude"], "cwd": "~" },
        { "path": "kitty", "args": ["claude"], "cwd": "~" },
        { "path": "xterm", "args": ["-e", "claude"], "cwd": "~" }
      ]
    },
    "powershell": {
      "label": "PowerShell",
      "windows": { "path": "powershell.exe", "args": ["-NoExit"], "cwd": "%USERPROFILE%" },
      // Linux: il terminale del desktop (il primo installato)
      "linux": { "label": "Terminale", "path": ["konsole", "gnome-terminal", "alacritty", "kitty", "xfce4-terminal", "xterm"], "cwd": "~" }
    },
    "files": {
      "label": "File",
      "windows": { "path": "explorer.exe", "args": ["%USERPROFILE%"] },
      "linux": { "path": "xdg-open", "args": ["~"] }
    },
    "taskmgr": {
      "label": "Gestione attività",
      "windows": { "path": "taskmgr.exe" },
      "linux": { "label": "Monitor di sistema", "path": ["plasma-systemmonitor", "gnome-system-monitor", "ksysguard", "xfce4-taskmanager"] }
    },
    // Screenshot di un'area (su Windows il pulsante usa Win+Shift+S)
    "screenshot": {
      "label": "Screenshot",
      "linux": [
        { "path": "spectacle", "args": ["--region"] },
        { "path": "gnome-screenshot", "args": ["--area"] },
        { "path": "flameshot", "args": ["gui"] }
      ]
    },
    "discord": {
      "label": "Discord",
      "toggle": true,
      "process": "discord",
      "windows": { "path": "%LOCALAPPDATA%\\Discord\\Update.exe", "args": ["--processStart", "Discord.exe"] },
      "linux": { "path": "discord" }
    },
    // ---- Giochi (pagina GAMES). Per un altro gioco copia una voce e cambia percorso e processo.
    "hearthstone": {
      "label": "Hearthstone",
      "game": true,
      "whenRunning": "focus",
      "process": "hearthstone",
      // il launcher di Hearthstone apre Battle.net e avvia il gioco
      "windows": { "path": ["D:\\Hearthstone\\Hearthstone Beta Launcher.exe", "C:\\Program Files (x86)\\Hearthstone\\Hearthstone Beta Launcher.exe"] }
    },
    "world_of_tanks": {
      "label": "World of Tanks",
      "game": true,
      "whenRunning": "focus",
      "process": "worldoftanks",
      // come il collegamento del Game Center sul desktop
      "windows": { "path": ["D:\\World_of_Tanks_EU\\wgc_api.exe", "C:\\Games\\World_of_Tanks_EU\\wgc_api.exe"], "args": ["--open"] }
    },
    "league_of_legends": {
      "label": "League of Legends",
      "game": true,
      "whenRunning": "focus",
      "process": ["league of legends", "leagueclientux"],
      "windows": {
        "path": ["D:\\Riot Games\\Riot Client\\RiotClientServices.exe", "C:\\Riot Games\\Riot Client\\RiotClientServices.exe"],
        "args": ["--launch-product=league_of_legends", "--launch-patchline=live"]
      }
    }
  }
}
