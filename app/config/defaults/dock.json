// Layout della dock. Modifica e salva: il tablet si aggiorna da solo.
//
// Ogni pagina è una griglia (default 5 colonne x 3 righe, o "columns"/"rows"
// della pagina). Le tile si dispongono da sinistra a destra; "w"/"h" = celle.
//
// Tile pulsante:
//   { "label": "SALVA", "icon": "save", "color": "#2e7d32", "sub": "Ctrl+S",
//     "action": { ... }, "repeat": true, "confirm": true }
//   repeat  = tenendo premuto l'azione si ripete (volume)
//   confirm = va tenuto premuto ~1s (azioni delicate)
//   showRunning = id di un'app di apps.json: pallino verde quando è aperta
//   id    = nome fisso del pulsante (serve al pannello di controllo per ricordare
//           ordine e pulsanti nascosti; senza id vale la posizione nella pagina)
//
// Windows e Linux (il sistema si riconosce da solo):
//   "os": "linux"  (o "windows")       -> pulsante/pagina solo su quel sistema
//   "linux": { "label": "TERMINALE" }  -> campi che cambiano su quel sistema
//                                         (anche "action"; idem "windows": {...})
//   "autoGrid": true (pagina)          -> colonne e righe scelte in base ai pulsanti
//
// Azioni:
//   { "type": "launch",   "app": "blender" }                 -> apps.json
//   { "type": "hotkey",   "keys": ["CTRL","S"], "focus": "blender" }
//   { "type": "key",      "key": "F12" }
//   { "type": "text",     "value": "ciao\n" }
//   { "type": "media",    "command": "play_pause" }  next, previous, stop -> app musicale
//                         volume_up, volume_down, mute                  -> volume di SISTEMA
//                         app_volume_up, app_volume_down, app_mute      -> volume dell'app musicale
//   { "type": "open_url", "url": "https://github.com" }
//   { "type": "command",  "id": "lock_pc" }                   -> commands.json
//   { "type": "page",     "page": "blender" }
//   { "type": "discord",  "command": "stream" }  mute, deaf, video (webcam), stream (Go Live del gioco aperto)
//   { "type": "macro",    "steps": [ {azione}, {"type":"wait","ms":300}, ... ] }
//   "focus" (opzionale) porta prima in primo piano il programma (nome processo).
//
// Tile widget:
//   { "widget": "system" }  { "widget": "nowplaying" }  { "widget": "queue" }
//   { "widget": "github" }  { "widget": "todo" }        { "widget": "clock" }
//   { "widget": "claude" }  { "widget": "chat", "provider": "ollama" }  { "widget": "discord" }
//   { "widget": "screens" } (monitor e disposizione delle finestre)  { "widget": "audio" } (dispositivi e volume delle app)
//   { "widget": "mail" }    (posta in arrivo; account dal pannello di controllo)
//   { "widget": "viber" } (pannelli e task di Viber)
//   { "widget": "vdesk", "system": "windows" } (guida ai desktop virtuali; "linux" per partire da Linux)
//
// "description" = testo mostrato nel pannello di controllo sul PC, dove scegli
// quali pagine stanno nella barra del tablet e in che ordine (config/layout.json).
//
// Icone disponibili: vedi README.
