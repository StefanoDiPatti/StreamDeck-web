// Comandi consentiti per i pulsanti { "type": "command", "id": "<id>" }.
// Il tablet può solo scegliere un id di questa lista: nessuna shell libera.
//  cmd / args     : programma e argomenti (varianti "windows" / "linux")
//  showOutput     : mostra l'output sul tablet in una finestra
//  timeoutMs      : tempo massimo (default 20s)
//  "linux" può essere una lista di alternative: vale la prima installata
{
  "commands": {
    "lock_pc": {
      "label": "Blocca PC",
      "windows": { "cmd": "rundll32.exe", "args": ["user32.dll,LockWorkStation"] },
      "linux": { "cmd": "loginctl", "args": ["lock-session"] }
    },
    "monitor_off": {
      "label": "Schermo spento",
      // {root} = cartella della dock
      "windows": { "cmd": "powershell.exe", "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-WindowStyle", "Hidden", "-File", "{root}\\scripts\\windows\\monitor-off.ps1"] },
      "linux": [
        { "cmd": "kscreen-doctor", "args": ["--dpms", "off"] },
        { "cmd": "xset", "args": ["dpms", "force", "off"] }
      ]
    },
    "show_desktop": {
      "label": "Mostra desktop",
      // KDE: la scorciatoia "Show Desktop" di KWin; altrimenti wmctrl (X11)
      "linux": [
        { "cmd": "qdbus6", "args": ["org.kde.kglobalaccel", "/component/kwin", "org.kde.kglobalaccel.Component.invokeShortcut", "Show Desktop"] },
        { "cmd": "qdbus", "args": ["org.kde.kglobalaccel", "/component/kwin", "org.kde.kglobalaccel.Component.invokeShortcut", "Show Desktop"] },
        { "cmd": "wmctrl", "args": ["-k", "on"] }
      ]
    },
    "openclaw_health": {
      "label": "OpenClaw health",
      "cmd": "openclaw", "args": ["health"], "showOutput": true, "timeoutMs": 30000
    },
    "openclaw_status": {
      "label": "OpenClaw status",
      "cmd": "openclaw", "args": ["daemon", "status"], "showOutput": true, "timeoutMs": 30000
    },
    "openclaw_restart": {
      "label": "Riavvio OpenClaw",
      "cmd": "openclaw", "args": ["daemon", "restart"], "showOutput": true, "timeoutMs": 90000
    },
    "openclaw_dashboard": {
      "label": "Dashboard OpenClaw",
      "cmd": "openclaw", "args": ["dashboard"], "timeoutMs": 30000
    },
    "ollama_ps": {
      "label": "Modelli Ollama attivi",
      "cmd": "ollama", "args": ["ps"], "showOutput": true
    },
    "git_status_projects": {
      "label": "Git status",
      "cmd": "git", "args": ["status", "--short", "--branch"],
      "cwd": "~/Documents/AI Projects",
      "showOutput": true
    }
  }
}
