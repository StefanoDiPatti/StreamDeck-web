// Layout della dock. Modifica e salva: il tablet si aggiorna da solo.
//
// Ogni pagina è una griglia (default 5 colonne x 3 righe). Le tile si
// dispongono da sinistra a destra; "w"/"h" = quante celle occupano.
//
// Tile pulsante:
//   { "label": "SALVA", "icon": "save", "color": "#2e7d32", "sub": "Ctrl+S",
//     "action": { ... }, "repeat": true, "confirm": true }
//   repeat  = tenendo premuto l'azione si ripete (volume)
//   confirm = va tenuto premuto ~1s (azioni delicate)
//
// Azioni:
//   { "type": "launch",   "app": "blender" }                 -> apps.json
//   { "type": "hotkey",   "keys": ["CTRL","S"], "focus": "blender" }
//   { "type": "key",      "key": "F12" }
//   { "type": "text",     "value": "ciao\n" }
//   { "type": "media",    "command": "play_pause" }  (next, previous, stop, volume_up, volume_down, mute)
//   { "type": "open_url", "url": "https://github.com" }
//   { "type": "command",  "id": "lock_pc" }                   -> commands.json
//   { "type": "page",     "page": "blender" }
//   { "type": "macro",    "steps": [ {azione}, {"type":"wait","ms":300}, ... ] }
//   "focus" (opzionale) porta prima in primo piano il programma (nome processo).
//
// Tile widget:
//   { "widget": "system" }  { "widget": "nowplaying" }  { "widget": "github" }
//   { "widget": "todo" }    { "widget": "clock" }
//   { "widget": "chat", "provider": "ollama" | "claude" }
//
// Icone disponibili: vedi README (play, pause, next, prev, cube, film, code,
// terminal, chat, sparkle, github, save, undo, redo, lock, ...).
{
  "title": "COMMAND DOCK",
  "grid": { "columns": 5, "rows": 3 },
  "home": "main",
  "pages": [
    {
      "id": "main",
      "title": "HOME",
      "icon": "home",
      "tiles": [
        { "widget": "system", "w": 2, "h": 2 },
        { "widget": "nowplaying", "w": 3, "h": 2 },
        { "label": "VS CODE", "icon": "code", "color": "#1e6fb8", "action": { "type": "launch", "app": "vscode" } },
        { "label": "CLAUDE CODE", "icon": "sparkle", "color": "#b65a3a", "action": { "type": "launch", "app": "claude_code" } },
        { "label": "BLENDER", "icon": "cube", "color": "#d9730d", "action": { "type": "page", "page": "blender" } },
        { "label": "DAVINCI", "icon": "film", "color": "#6b4fa0", "action": { "type": "page", "page": "davinci" } },
        { "label": "BLOCCA", "icon": "lock", "color": "#7a2730", "confirm": true, "action": { "type": "command", "id": "lock_pc" } }
      ]
    },
    {
      "id": "media",
      "title": "MUSICA",
      "icon": "music",
      "tiles": [
        { "widget": "nowplaying", "w": 5, "h": 2 },
        { "label": "VOL -", "icon": "voldown", "repeat": true, "action": { "type": "media", "command": "volume_down" } },
        { "label": "MUTE", "icon": "mute", "action": { "type": "media", "command": "mute" } },
        { "label": "VOL +", "icon": "volup", "repeat": true, "action": { "type": "media", "command": "volume_up" } },
        { "label": "STOP", "icon": "stop", "action": { "type": "media", "command": "stop" } },
        { "label": "APPLE MUSIC", "icon": "music", "color": "#c2334d", "action": { "type": "launch", "app": "apple_music" } }
      ]
    },
    {
      "id": "apps",
      "title": "APP",
      "icon": "apps",
      "tiles": [
        { "label": "BLENDER", "icon": "cube", "color": "#d9730d", "action": { "type": "launch", "app": "blender" } },
        { "label": "DAVINCI", "icon": "film", "color": "#6b4fa0", "action": { "type": "launch", "app": "davinci" } },
        { "label": "VS CODE", "icon": "code", "color": "#1e6fb8", "action": { "type": "launch", "app": "vscode" } },
        { "label": "UNREAL", "icon": "cube", "color": "#444b55", "action": { "type": "launch", "app": "unreal" } },
        { "label": "EPIC", "icon": "apps", "color": "#333a44", "action": { "type": "launch", "app": "epic" } },
        { "label": "APPLE MUSIC", "icon": "music", "color": "#c2334d", "action": { "type": "launch", "app": "apple_music" } },
        { "label": "CLAUDE", "icon": "sparkle", "color": "#b65a3a", "action": { "type": "launch", "app": "claude_desktop" } },
        { "label": "STEAM", "icon": "play", "color": "#1b3a5c", "action": { "type": "launch", "app": "steam" } },
        { "label": "DISCORD", "icon": "chat", "color": "#4752c4", "action": { "type": "launch", "app": "discord" } },
        { "label": "FILE", "icon": "folder", "action": { "type": "launch", "app": "files" } },
        { "label": "TERMINALE", "icon": "terminal", "action": { "type": "launch", "app": "terminal" } },
        { "label": "TASK MGR", "icon": "cpu", "action": { "type": "launch", "app": "taskmgr" } },
        { "label": "SCREENSHOT", "icon": "camera", "sub": "Win+Shift+S", "action": { "type": "hotkey", "keys": ["WIN", "SHIFT", "S"] } },
        { "label": "DESKTOP", "icon": "desktop", "sub": "Win+D", "action": { "type": "hotkey", "keys": ["WIN", "D"] } },
        { "label": "BLOCCA", "icon": "lock", "color": "#7a2730", "confirm": true, "action": { "type": "command", "id": "lock_pc" } }
      ]
    },
    {
      "id": "dev",
      "title": "DEV",
      "icon": "code",
      "tiles": [
        { "label": "VS CODE", "icon": "code", "color": "#1e6fb8", "action": { "type": "launch", "app": "vscode" } },
        { "label": "CLAUDE CODE", "icon": "sparkle", "color": "#b65a3a", "action": { "type": "launch", "app": "claude_code" } },
        { "label": "TERMINALE", "icon": "terminal", "action": { "type": "launch", "app": "terminal" } },
        { "label": "GITHUB", "icon": "github", "action": { "type": "open_url", "url": "https://github.com" } },
        { "label": "GIT STATUS", "icon": "github", "action": { "type": "command", "id": "git_status_projects" } },
        { "label": "OPENCLAW", "icon": "robot", "sub": "health", "color": "#2c5e4f", "action": { "type": "command", "id": "openclaw_health" } },
        { "label": "OPENCLAW", "icon": "refresh", "sub": "riavvia", "color": "#2c5e4f", "confirm": true, "action": { "type": "command", "id": "openclaw_restart" } },
        { "label": "DASHBOARD", "icon": "desktop", "sub": "OpenClaw", "color": "#2c5e4f", "action": { "type": "command", "id": "openclaw_dashboard" } },
        { "label": "OLLAMA PS", "icon": "chat", "action": { "type": "command", "id": "ollama_ps" } },
        { "label": "CLAUDE.AI", "icon": "sparkle", "action": { "type": "open_url", "url": "https://claude.ai" } },
        { "label": "SALVA", "icon": "save", "sub": "Ctrl+S", "action": { "type": "hotkey", "keys": ["CTRL", "S"] } },
        { "label": "PALETTE", "icon": "keyboard", "sub": "Ctrl+Shift+P", "action": { "type": "hotkey", "keys": ["CTRL", "SHIFT", "P"] } },
        { "label": "TERM VSC", "icon": "terminal", "sub": "Ctrl+`", "action": { "type": "hotkey", "keys": ["CTRL", "BACKQUOTE"] } },
        { "label": "ANNULLA", "icon": "undo", "sub": "Ctrl+Z", "action": { "type": "hotkey", "keys": ["CTRL", "Z"] } },
        { "label": "RIPETI", "icon": "redo", "sub": "Ctrl+Y", "action": { "type": "hotkey", "keys": ["CTRL", "Y"] } }
      ]
    },
    {
      "id": "github",
      "title": "GITHUB",
      "icon": "github",
      "tiles": [ { "widget": "github", "w": 5, "h": 3 } ]
    },
    {
      "id": "ollama",
      "title": "OLLAMA",
      "icon": "chat",
      "tiles": [ { "widget": "chat", "provider": "ollama", "w": 5, "h": 3 } ]
    },
    {
      "id": "claude",
      "title": "CLAUDE",
      "icon": "sparkle",
      "tiles": [ { "widget": "chat", "provider": "claude", "w": 5, "h": 3 } ]
    },
    {
      "id": "todo",
      "title": "TODO",
      "icon": "check",
      "tiles": [
        { "widget": "todo", "w": 3, "h": 3 },
        { "widget": "clock", "w": 2, "h": 3 }
      ]
    },
    {
      "id": "blender",
      "title": "BLENDER",
      "icon": "cube",
      "tab": false,
      "tiles": [
        { "label": "APRI", "icon": "cube", "color": "#d9730d", "action": { "type": "launch", "app": "blender" } },
        { "label": "SALVA", "icon": "save", "sub": "Ctrl+S", "action": { "type": "hotkey", "keys": ["CTRL", "S"], "focus": "blender" } },
        { "label": "ANNULLA", "icon": "undo", "sub": "Ctrl+Z", "repeat": true, "action": { "type": "hotkey", "keys": ["CTRL", "Z"], "focus": "blender" } },
        { "label": "RIPETI", "icon": "redo", "sub": "Ctrl+Shift+Z", "action": { "type": "hotkey", "keys": ["CTRL", "SHIFT", "Z"], "focus": "blender" } },
        { "label": "RENDER", "icon": "camera", "sub": "F12", "color": "#a3530a", "action": { "type": "key", "key": "F12", "focus": "blender" } },
        { "label": "PLAY", "icon": "play", "sub": "Spazio", "action": { "type": "key", "key": "SPACE", "focus": "blender" } },
        { "label": "CAMERA", "icon": "camera", "sub": "Num 0", "action": { "type": "key", "key": "NUM0", "focus": "blender" } },
        { "label": "FRONTE", "icon": "cube", "sub": "Num 1", "action": { "type": "key", "key": "NUM1", "focus": "blender" } },
        { "label": "DESTRA", "icon": "cube", "sub": "Num 3", "action": { "type": "key", "key": "NUM3", "focus": "blender" } },
        { "label": "ALTO", "icon": "cube", "sub": "Num 7", "action": { "type": "key", "key": "NUM7", "focus": "blender" } },
        { "label": "WIREFRAME", "icon": "cube", "sub": "Shift+Z", "action": { "type": "hotkey", "keys": ["SHIFT", "Z"], "focus": "blender" } },
        { "label": "SCHERMO", "icon": "fullscreen", "sub": "Ctrl+Spazio", "action": { "type": "hotkey", "keys": ["CTRL", "SPACE"], "focus": "blender" } },
        { "label": "APRI FILE", "icon": "folder", "sub": "Ctrl+O", "action": { "type": "hotkey", "keys": ["CTRL", "O"], "focus": "blender" } },
        { "label": "RENDER ANIM", "icon": "film", "sub": "Ctrl+F12", "confirm": true, "action": { "type": "hotkey", "keys": ["CTRL", "F12"], "focus": "blender" } },
        { "label": "INDIETRO", "icon": "back", "action": { "type": "page", "page": "main" } }
      ]
    },
    {
      "id": "davinci",
      "title": "DAVINCI RESOLVE",
      "icon": "film",
      "tab": false,
      "tiles": [
        { "label": "APRI", "icon": "film", "color": "#6b4fa0", "action": { "type": "launch", "app": "davinci" } },
        { "label": "SALVA", "icon": "save", "sub": "Ctrl+S", "action": { "type": "hotkey", "keys": ["CTRL", "S"], "focus": "Resolve" } },
        { "label": "PLAY", "icon": "play", "sub": "Spazio", "action": { "type": "key", "key": "SPACE", "focus": "Resolve" } },
        { "label": "STOP", "icon": "stop", "sub": "K", "action": { "type": "key", "key": "K", "focus": "Resolve" } },
        { "label": "TAGLIA", "icon": "cut", "sub": "Ctrl+B", "action": { "type": "hotkey", "keys": ["CTRL", "B"], "focus": "Resolve" } },
        { "label": "MARK IN", "icon": "flag", "sub": "I", "action": { "type": "key", "key": "I", "focus": "Resolve" } },
        { "label": "MARK OUT", "icon": "flag", "sub": "O", "action": { "type": "key", "key": "O", "focus": "Resolve" } },
        { "label": "ANNULLA", "icon": "undo", "sub": "Ctrl+Z", "repeat": true, "action": { "type": "hotkey", "keys": ["CTRL", "Z"], "focus": "Resolve" } },
        { "label": "RIPETI", "icon": "redo", "sub": "Ctrl+Shift+Z", "action": { "type": "hotkey", "keys": ["CTRL", "SHIFT", "Z"], "focus": "Resolve" } },
        { "label": "FRAME -", "icon": "prev", "sub": "←", "repeat": true, "action": { "type": "key", "key": "LEFT", "focus": "Resolve" } },
        { "label": "EDIT", "icon": "film", "sub": "Shift+4", "action": { "type": "hotkey", "keys": ["SHIFT", "4"], "focus": "Resolve" } },
        { "label": "COLOR", "icon": "film", "sub": "Shift+6", "action": { "type": "hotkey", "keys": ["SHIFT", "6"], "focus": "Resolve" } },
        { "label": "DELIVER", "icon": "camera", "sub": "Shift+8", "action": { "type": "hotkey", "keys": ["SHIFT", "8"], "focus": "Resolve" } },
        { "label": "FRAME +", "icon": "next", "sub": "→", "repeat": true, "action": { "type": "key", "key": "RIGHT", "focus": "Resolve" } },
        { "label": "INDIETRO", "icon": "back", "action": { "type": "page", "page": "main" } }
      ]
    }
  ]
}
