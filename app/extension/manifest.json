{
  "manifest_version": 3,
  "name": "Vibe Deck Bridge",
  "version": "1.2.0",
  "description": "Collega Apple Music web, YouTube e YouTube Music alla Vibe Deck sul tablet (coda, volume dell'app, durata esatta).",
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://music.apple.com/*",
    "https://beta.music.apple.com/*",
    "https://music.youtube.com/*",
    "https://www.youtube.com/*"
  ],
  "permissions": ["storage", "scripting"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Vibe Deck Bridge", "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["https://music.apple.com/*", "https://beta.music.apple.com/*", "https://music.youtube.com/*", "https://www.youtube.com/*"],
      "js": ["page.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://music.apple.com/*", "https://beta.music.apple.com/*", "https://music.youtube.com/*", "https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
