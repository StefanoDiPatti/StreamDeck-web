# Copiato automaticamente in .env al primo avvio (con un codice casuale).
# Il file .env resta sul PC: non metterlo su GitHub.

# Porta del server (sul tablet: http://IP_DEL_PC:8787)
PORT=8787
HOST=0.0.0.0

# Codice di accesso chiesto dal tablet la prima volta. Vuoto = nessun controllo.
DOCK_TOKEN=

# Forza l'IP mostrato all'avvio (se il PC ha più schede di rete)
SERVER_IP=

# GitHub: token personale (fine-grained, sola lettura). Se vuoto si usa `gh auth token`.
GITHUB_TOKEN=
GITHUB_OWNER=

# Claude API (opzionale). Se vuoto, la pagina Claude usa Claude Code installato sul PC.
ANTHROPIC_API_KEY=

# Ollama, se non è sul PC locale
OLLAMA_URL=

# debug | info | warn | error
LOG_LEVEL=info

# 1 = accetta connessioni anche da IP non locali (sconsigliato)
ALLOW_ANY_IP=0
